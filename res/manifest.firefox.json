{
  "manifest_version": 2,
  "name": "__MSG_extName__",
  "default_locale": "en",
  "description": "__MSG_extDescription__",
  "version": "0.1.15",
  "homepage_url": "https://github.com/Keepmark",
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "keepmark@proton.me",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "browser_action": {
    "default_icon": {
      "16": "assets/notsynced16.png",
      "32": "assets/notsynced32.png"
    },
    "theme_icons": [
      { "light": "assets/notsynced-dark16.png", "dark": "assets/notsynced16.png", "size": 16 },
      { "light": "assets/notsynced-dark32.png", "dark": "assets/notsynced32.png", "size": 32 }
    ],
    "default_popup": "popup.html",
    "default_title": "__MSG_actionTitle__"
  },
  "background": {
    "page": "background.html"
  },
  "permissions": [
    "alarms",
    "bookmarks",
    "downloads",
    "notifications",
    "storage",
    "unlimitedStorage"
  ],
  "content_security_policy": "connect-src https: http://localhost:* http://127.0.0.1:*; default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline';",
  "incognito": "not_allowed"
}
