{
  "manifest_version": 3,
  "name": "Keepmark",
  "description": "Keepmark bookmark sync (xBrowserSync-compatible).",
  "version": "0.1.0",
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "action": {
    "default_icon": {
      "32": "assets/notsynced32.png"
    },
    "default_popup": "popup.html",
    "default_title": "Keepmark"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["alarms", "bookmarks", "downloads", "notifications", "storage", "tabs", "unlimitedStorage"]
}
